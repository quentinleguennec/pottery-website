---
import "../styles/global.css";
import { site } from "../data/site";

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.description } = Astro.props;
const pageTitle = title ? `${title} — ${site.artistName}` : site.artistName;
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f3efe8" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500&family=Newsreader:opsz,wght@6..72,400;6..72,500&display=swap"
      rel="stylesheet"
    />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <header class="site-header">
      <a class="brand" href="/">{site.artistName}</a>
      <nav class="nav" aria-label="Primary">
        <!-- <a href="/work" aria-current={path.startsWith("/work") ? "page" : undefined}>Work</a> -->
        <a href="/about" aria-current={path === "/about" ? "page" : undefined}>About</a>
        <!-- <a href="/process" aria-current={path === "/process" ? "page" : undefined}>Process</a> -->
      </nav>
    </header>
    <main id="content">
      <slot />
    </main>
    <footer class="site-footer">
      <p>{site.artistName}</p>
      <p>{site.tagline}</p>
    </footer>
  </body>
</html>
